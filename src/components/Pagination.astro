---
interface Props {
	currentPage: number;
	totalPages: number;
	basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;

function pageUrl(page: number) {
	return page === 1 ? `${basePath}/` : `${basePath}/page/${page}/`;
}

const prev = currentPage > 1 ? currentPage - 1 : null;
const next = currentPage < totalPages ? currentPage + 1 : null;
---

{totalPages > 1 && (
	<nav aria-label="Pagination" class="pagination">
		{prev !== null ? (
			<a href={pageUrl(prev)} class="page-link" rel="prev">&larr; Previous</a>
		) : (
			<span class="page-link disabled">&larr; Previous</span>
		)}
		<span class="page-info">Page {currentPage} of {totalPages}</span>
		{next !== null ? (
			<a href={pageUrl(next)} class="page-link" rel="next">Next &rarr;</a>
		) : (
			<span class="page-link disabled">Next &rarr;</span>
		)}
	</nav>
)}

<style>
	:root {
		--c-purple: #7C3AED;
		--c-blue: #6366F1;
		--c-gray: #647488;
		--c-border: #E8ECF0;
	}
	.pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		margin: 3rem 0 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--c-border);
	}
	.page-link {
		padding: 8px 20px;
		border: 1.5px solid var(--c-border);
		border-radius: 8px;
		text-decoration: none;
		color: var(--c-purple);
		font-size: 0.875rem;
		font-weight: 600;
		transition: background 0.15s, border-color 0.15s, color 0.15s;
	}
	.page-link:hover:not(.disabled) {
		background: linear-gradient(135deg, #7C3AED, #6366F1);
		color: #fff;
		border-color: #7C3AED;
		text-decoration: none;
	}
	.disabled {
		color: var(--c-gray);
		pointer-events: none;
		opacity: 0.5;
	}
	.page-info {
		font-size: 0.875rem;
		color: var(--c-gray);
		font-weight: 500;
	}
</style>
