---
const { pathname } = Astro.url;
const isActive = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
};
---
<header class="site-header">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <div class="nav-logo-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M4 4 H14 L4 14 H14" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="14" cy="4" r="1.8" fill="#fff" opacity="0.9"/>
          <circle cx="9" cy="9" r="1.2" fill="#fff" opacity="0.6"/>
          <circle cx="4" cy="14" r="1.8" fill="#fff" opacity="0.9"/>
        </svg>
      </div>
      <span class="nav-logo-text">Zotopie</span>
    </a>
    <div class="nav-right">
      <nav class="nav-links">
        <a href="/" class:list={[{ 'nav-active': isActive('/') }]}>Home</a>
        <a href="/category/" class:list={[{ 'nav-active': isActive('/category/') }]}>Categories</a>
        <a href="/reviews/" class:list={[{ 'nav-active': isActive('/reviews/') || isActive('/ai-tools/') || isActive('/reddit/') }]}>Reviews</a>
        <a href="/alternatives/" class:list={[{ 'nav-active': isActive('/alternatives/') }]}>Alternatives</a>
        <a href="/comparisons/" class:list={[{ 'nav-active': isActive('/comparisons/') || isActive('/compare/') }]}>Comparisons</a>
        <a href="/best/" class:list={[{ 'nav-active': isActive('/best/') }]}>Best Tools</a>
      </nav>
      <form class="nav-search-form" action="/search" method="get" role="search">
        <svg class="nav-s-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2.5" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input id="nav-q" name="q" type="text" placeholder="Search tools…"
          autocomplete="off" spellcheck="false" class="nav-s-input" aria-label="Search tools" />
        <kbd class="nav-s-kbd" aria-hidden="true">/</kbd>
      </form>
      <a href="/search/" class="nav-s-mobile" aria-label="Search tools">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </a>
      <button class="nav-hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav-links" aria-label="Mobile navigation">
      <a href="/">Home</a>
      <a href="/category/">Categories</a>
      <a href="/reviews/">Reviews</a>
      <a href="/alternatives/">Alternatives</a>
      <a href="/comparisons/">Comparisons</a>
      <a href="/best/">Best Tools</a>
      <a href="/search/">Search Tools</a>
    </nav>
  </div>
</header>

<style>
  :root {
    --c-purple: #7C3AED;
    --c-purple-light: #EDE9FE;
    --c-blue: #6366F1;
    --c-dark: #0F172A;
    --c-border: #E8ECF0;
    --c-bg: #FAFBFC;
    --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .site-header {
    border-bottom: 1px solid var(--c-border);
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 12px rgba(15,23,42,0.06);
    font-family: var(--font-sans);
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .nav-logo-icon {
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, var(--c-purple), var(--c-blue));
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .nav-logo-text {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--c-dark);
    letter-spacing: -0.4px;
  }
  .nav-logo:hover { text-decoration: none; opacity: 0.9; }
  .nav-links { display: flex; align-items: center; gap: 4px; }
  .nav-links a {
    font-size: 0.875rem;
    color: #4B5563;
    font-weight: 500;
    padding: 11px 12px;
    border-radius: 8px;
    transition: background 0.15s, color 0.15s;
    text-decoration: none;
  }
  .nav-links a:hover { color: var(--c-purple); background: var(--c-purple-light); text-decoration: none; }
  .nav-links a.nav-active { color: var(--c-purple); background: var(--c-purple-light); font-weight: 600; }
  .nav-right { display: flex; align-items: center; gap: 12px; }
  .nav-search-form { position: relative; display: flex; align-items: center; }
  .nav-s-icon { position: absolute; left: 10px; pointer-events: none; flex-shrink: 0; }
  .nav-s-input {
    width: 200px;
    padding: 8px 36px 8px 32px;
    font-size: 0.875rem;
    border: 1.5px solid var(--c-border);
    border-radius: 22px;
    background: var(--c-bg);
    color: var(--c-dark);
    outline: none;
    font-family: var(--font-sans);
    transition: width 0.25s, border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .nav-s-input::placeholder { color: #9ca3af; }
  .nav-s-input:focus {
    width: 260px;
    border-color: var(--c-purple);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(124,58,237,0.12);
  }
  .nav-s-kbd {
    position: absolute; right: 10px;
    font-size: 0.7rem; color: #9ca3af;
    background: #f3f4f6; border: 1px solid #e5e7eb;
    border-radius: 4px; padding: 1px 5px;
    pointer-events: none; font-family: var(--font-sans);
    transition: opacity 0.15s;
  }
  .nav-s-input:focus + .nav-s-kbd { opacity: 0; }
  .nav-s-mobile {
    display: none;
    color: #6b7280;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: background 0.15s, color 0.15s;
  }
  .nav-s-mobile:hover { background: var(--c-purple-light); color: var(--c-purple); text-decoration: none; }
  .nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    border-radius: 8px;
    color: var(--c-dark);
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .nav-hamburger:hover { background: var(--c-purple-light); }
  .hamburger-bar {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav-hamburger[aria-expanded="true"] .hamburger-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-hamburger[aria-expanded="true"] .hamburger-bar:nth-child(2) { opacity: 0; }
  .nav-hamburger[aria-expanded="true"] .hamburger-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile-menu {
    display: none;
    border-top: 1px solid var(--c-border);
    background: rgba(255,255,255,0.99);
    padding: 8px 16px 16px;
    box-shadow: 0 8px 24px rgba(15,23,42,0.08);
  }
  .mobile-menu.is-open { display: block; }
  .mobile-nav-links { display: flex; flex-direction: column; gap: 2px; }
  .mobile-nav-links a {
    display: block;
    padding: 11px 16px;
    font-size: 0.95rem;
    font-weight: 500;
    color: #4B5563;
    border-radius: 8px;
    transition: background 0.15s, color 0.15s;
    text-decoration: none;
  }
  .mobile-nav-links a:hover { color: var(--c-purple); background: var(--c-purple-light); text-decoration: none; }
  @media (max-width: 768px) {
    .nav-search-form { display: none; }
    .nav-s-mobile { display: flex; }
  }
  @media (max-width: 600px) {
    .nav-links { display: none; }
    .nav-hamburger { display: flex; }
  }
</style>

<script>
  document.addEventListener('keydown', function(e) {
    var tag = document.activeElement && (document.activeElement as HTMLElement).tagName;
    if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') {
      e.preventDefault();
      var navQ = document.getElementById('nav-q');
      if (navQ) (navQ as HTMLInputElement).focus();
    }
  });
  (function() {
    var hamburger = document.getElementById('nav-hamburger') as HTMLButtonElement;
    var mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
    if (!hamburger || !mobileMenu) return;
    function closeMenu() {
      hamburger.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      mobileMenu.classList.remove('is-open');
    }
    hamburger.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = hamburger.getAttribute('aria-expanded') === 'true';
      if (isOpen) { closeMenu(); }
      else {
        hamburger.setAttribute('aria-expanded', 'true');
        mobileMenu.setAttribute('aria-hidden', 'false');
        mobileMenu.classList.add('is-open');
      }
    });
    document.addEventListener('click', function(e) {
      if (!(e.target as Element).closest('.site-header')) closeMenu();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeMenu();
    });
  })();
</script>
