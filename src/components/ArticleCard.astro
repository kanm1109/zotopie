---
import FormattedDate from './FormattedDate.astro';

interface Props {
	title: string;
	description: string;
	publishDate: Date;
	slug: string;
	category: string;
	tags?: string[];
	featuredImage?: string;
	featured?: boolean;
}

const {
	title,
	description,
	publishDate,
	slug,
	category,
	tags = [],
	featuredImage,
	featured = false,
} = Astro.props;

const articleUrl = `/${category}/${slug}/`;
---

<article class:list={['card', { featured }]}>
	{featuredImage && (
		<a href={articleUrl} class="card-image">
			<img src={featuredImage} alt={title} loading="lazy" />
		</a>
	)}
	<div class="card-body">
		<div class="card-meta">
			<a href={`/${category}/`} class="cat-tag">{category}</a>
			<FormattedDate date={publishDate} />
		</div>
		<h2 class="card-title">
			<a href={articleUrl}>{title}</a>
		</h2>
		<p class="card-desc">{description}</p>
		{tags.length > 0 && (
			<div class="card-tags">
				{tags.slice(0, 3).map((tag) => (
					<a href={`/tags/${tag}/`} class="tag">#{tag}</a>
				))}
			</div>
		)}
		<a href={articleUrl} class="card-cta">Read Article →</a>
	</div>
</article>

<style>
	:root {
		--c-purple: #7C3AED;
		--c-blue: #6366F1;
		--c-dark: #0F172A;
		--c-gray: #647488;
		--c-border: #E8ECF0;
	}
	.card {
		background: #fff;
		border: 1.5px solid var(--c-border);
		border-radius: 14px;
		overflow: hidden;
		transition: border-color 0.18s, box-shadow 0.18s, transform 0.15s;
		display: flex;
		flex-direction: column;
	}
	.card:hover {
		border-color: #C4B5FD;
		box-shadow: 0 6px 20px rgba(124,58,237,0.08);
		transform: translateY(-2px);
	}
	.card-image {
		display: block;
		overflow: hidden;
	}
	.card-image img {
		width: 100%;
		height: auto;
		border-radius: 0;
		transition: transform 0.3s;
	}
	.card:hover .card-image img {
		transform: scale(1.03);
	}
	.card-body {
		padding: 20px;
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.card-meta {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 8px;
		font-size: 0.8rem;
		color: var(--c-gray);
	}
	.cat-tag {
		background: linear-gradient(135deg, var(--c-purple), var(--c-blue));
		color: #fff;
		padding: 3px 9px;
		border-radius: 6px;
		text-decoration: none;
		text-transform: capitalize;
		font-weight: 600;
		font-size: 0.72rem;
		letter-spacing: 0.01em;
	}
	.cat-tag:hover { opacity: 0.9; text-decoration: none; }
	.card-title {
		font-size: 1.15rem;
		font-weight: 700;
		margin: 6px 0 10px;
		line-height: 1.3;
	}
	.card-title a {
		color: var(--c-dark);
		text-decoration: none;
	}
	.card-title a:hover { color: var(--c-purple); text-decoration: none; }
	.card-desc {
		font-size: 0.9rem;
		color: var(--c-gray);
		margin: 0 0 12px;
		line-height: 1.55;
		flex: 1;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: auto;
	}
	.tag {
		font-size: 0.78rem;
		color: var(--c-purple);
		text-decoration: none;
		font-weight: 500;
	}
	.tag:hover { text-decoration: underline; }
	.featured .card-title { font-size: 1.5rem; }
	.featured .card-body { padding: 28px; }
	.card-cta {
		display: inline-block;
		margin-top: 14px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--c-purple);
		text-decoration: none;
	}
	.card-cta:hover { text-decoration: underline; }
</style>
