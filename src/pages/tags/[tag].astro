---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { SITE_URL } from '../../consts';

export async function getStaticPaths() {
	const [blogs, reddits, threads, extensions, marketings] = await Promise.all([
		getCollection('blog', ({ data }) => !data.draft),
		getCollection('reddit', ({ data }) => !data.draft),
		getCollection('threads', ({ data }) => !data.draft),
		getCollection('extensions', ({ data }) => !data.draft),
		getCollection('marketing', ({ data }) => !data.draft),
	]);

	const allPosts = [
		...blogs.map((p) => ({ ...p, collection: 'blog' as const })),
		...reddits.map((p) => ({ ...p, collection: 'reddit' as const })),
		...threads.map((p) => ({ ...p, collection: 'threads' as const })),
		...extensions.map((p) => ({ ...p, collection: 'extensions' as const })),
		...marketings.map((p) => ({ ...p, collection: 'marketing' as const })),
	];

	const tagMap = new Map<string, typeof allPosts>();
	for (const post of allPosts) {
		for (const tag of post.data.tags) {
			if (!tagMap.has(tag)) tagMap.set(tag, []);
			tagMap.get(tag)!.push(post);
		}
	}

	return Array.from(tagMap.entries()).map(([tag, posts]) => ({
		params: { tag },
		props: {
			posts: posts.sort(
				(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
			),
		},
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead
			title={`#${tag} articles`}
			description={`All articles tagged with #${tag} on Zotopie.`}
			breadcrumbs={[
				{ name: 'Tags', url: `${SITE_URL}/tags/` },
				{ name: `#${tag}`, url: `${SITE_URL}/tags/${tag}/` },
			]}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<SiteHeader />
		<main class="tag-main">
			<div class="tag-header">
				<Breadcrumb
					items={[
						{ name: 'Tags', url: '/tags/' },
						{ name: `#${tag}`, url: `/tags/${tag}/` },
					]}
				/>
				<h1>#{tag}</h1>
				<p class="tag-count">{posts.length} article{posts.length !== 1 ? 's' : ''}</p>
			</div>
			<div class="posts-grid">
				{posts.map((post) => (
					<ArticleCard
						title={post.data.title}
						description={post.data.description}
						publishDate={post.data.publishDate}
						slug={post.id}
						category={post.collection}
						tags={post.data.tags}
						featuredImage={post.data.featuredImage}
					/>
				))}
			</div>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	:root {
		--c-purple: #7C3AED;
		--c-dark: #0F172A;
		--c-gray: #647488;
		--c-border: #E8ECF0;
		--font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
	}
	*, *::before, *::after { box-sizing: border-box; }
	body {
		font-family: var(--font-sans);
		color: var(--c-dark);
		background: #fff;
		-webkit-font-smoothing: antialiased;
	}
	.tag-main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px 80px;
	}
	.tag-header {
		padding: 40px 0 32px;
		border-bottom: 1px solid var(--c-border);
		margin-bottom: 40px;
	}
	h1 {
		font-size: 2.4rem;
		font-weight: 800;
		letter-spacing: -0.5px;
		color: var(--c-dark);
		margin: 8px 0 12px;
	}
	.tag-count {
		color: var(--c-gray);
		margin: 0;
		font-size: 1rem;
	}
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 24px;
	}
	@media (max-width: 640px) {
		.tag-main { padding: 0 16px 64px; }
		h1 { font-size: 1.8rem; }
		.tag-header { padding: 28px 0 24px; margin-bottom: 28px; }
		.posts-grid { grid-template-columns: 1fr; }
	}
</style>
