<script>
(function () {
  var nav = document.getElementById('cb-nav');
  if (!nav) return;

  var btns   = Array.from(nav.querySelectorAll('.cb-nav-btn'));
  var panels = Array.from(document.querySelectorAll('.cb-panel'));

  function activate(catId) {
    btns.forEach(function(btn) {
      var active = btn.dataset.cat === catId;
      btn.classList.toggle('cb-nav-active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    panels.forEach(function(panel) {
      var active = panel.id === 'cbp-' + catId;
      if (active) {
        panel.classList.remove('cb-panel-active');
        void panel.offsetHeight; // reflow so animation restarts each switch
        panel.classList.add('cb-panel-active');
      } else {
        panel.classList.remove('cb-panel-active');
      }
    });
  }

  btns.forEach(function(btn) {
    btn.addEventListener('click', function() { activate(btn.dataset.cat); });
  });

  nav.addEventListener('keydown', function(e) {
    var active = nav.querySelector('.cb-nav-btn.cb-nav-active');
    var idx    = btns.indexOf(active);
    if (e.key === 'ArrowDown' && idx < btns.length - 1) {
      e.preventDefault();
      btns[idx + 1].click();
      btns[idx + 1].focus();
    } else if (e.key === 'ArrowUp' && idx > 0) {
      e.preventDefault();
      btns[idx - 1].click();
      btns[idx - 1].focus();
    }
  });
})();
</script>

