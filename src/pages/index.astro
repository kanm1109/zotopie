---
import { getCollection } from 'astro:content';
import tools from "../data/generated/tools-enriched.json";
import taxonomies from "../data/taxonomies.json";
import bestPages from "../data/best-pages.json";
import homepageConfig from "../data/homepage-config.json";
import MainLayout from "../layouts/MainLayout.astro";
import ToolLogo from "../components/ToolLogo.astro";
import ArticleCard from "../components/ArticleCard.astro";

// ── Stats ────────────────────────────────────────────────
const toolCount = tools.length;
const catCount = taxonomies.length;
const comparePairs = new Set<string>();
tools.forEach((t) => {
  (t.alternatives || []).forEach((alt: string) => {
    const pair = [t.slug, alt].sort().join('_');
    comparePairs.add(pair);
  });
});
const compareCount = comparePairs.size;

// ── Hero autocomplete ────────────────────────────────────
const slimTools = tools.map((t) => [t.name, t.slug, t.rating]);
const slimCats = taxonomies.map((t) => [t.name, t.slug]);
const categoriesWithCount = taxonomies.map((cat) => ({
  ...cat,
  toolCount: tools.filter((t) => t.categories.includes(cat.slug)).length,
}));
const top8cats = [...categoriesWithCount].sort((a, b) => b.toolCount - a.toolCount).slice(0, 8);

// ── Collections ──────────────────────────────────────────
const [reddits, aiToolsCol, comparisonsCol] = await Promise.all([
  getCollection('reddit',       ({ data }) => !data.draft),
  getCollection('ai-tools',     ({ data }) => !data.draft),
  getCollection('comparisons',  ({ data }) => !data.draft),
]);

const latestReviews = [...aiToolsCol]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const latestComparisons = [...comparisonsCol]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const latestArticles = [...reddits]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

// ── Category Browser (fully dynamic from database) ───────
function toStars(rating: number): string {
  const r = Math.round(rating);
  return '★'.repeat(Math.min(r, 5)) + '☆'.repeat(Math.max(5 - r, 0));
}

// Build a set of all lowercase tag values from the ai-tools collection.
// A tool "has a review" when its slug appears as a tag in an editorial article —
// the same mechanism ArticleLayout uses to find the related tool, so both stay in sync.
const reviewedToolTags = new Set(
  aiToolsCol.flatMap((p: any) => (p.data.tags ?? []).map((tag: string) => tag.toLowerCase()))
);

const toolLabels       = homepageConfig.toolLabels       as Record<string, string>;
const toolDescriptions = homepageConfig.toolDescriptions as Record<string, string>;

// Selection priority: 1) has editorial review  2) affiliate approved  3) rating desc  4) name asc
const categoryBrowser = (taxonomies as any[]).map(cat => {
  const catTools = (tools as any[])
    .filter(t => (t.categories ?? []).includes(cat.slug))
    .map(t => ({ ...t, hasReview: reviewedToolTags.has(t.slug.toLowerCase()) }))
    .sort((a: any, b: any) => {
      if (a.hasReview   !== b.hasReview)          return a.hasReview         ? -1 : 1;
      if (a.affiliateApproved !== b.affiliateApproved) return a.affiliateApproved ? -1 : 1;
      if ((b.rating ?? 0) !== (a.rating ?? 0))   return (b.rating ?? 0) - (a.rating ?? 0);
      return a.name.localeCompare(b.name);
    });

  const totalCount = catTools.length;

  return {
    id:          cat.slug,
    name:        cat.name,
    description: cat.description,
    subtitle:    `${totalCount} Tools`,
    totalCount,
    tools: catTools.slice(0, 6).map((t: any) => {
      const rating = t.rating ?? null;
      return {
        slug:    t.slug,
        name:    t.name,
        rating,
        stars:   rating !== null ? toStars(rating) : null,
        label:   toolLabels[t.slug] ?? null,
        desc:    toolDescriptions[t.slug] ?? null,
        exists:  t.hasReview,
        toolObj: t,
      };
    }),
  };
}).filter((cat: any) => cat.totalCount > 0);

// Default category: AI Detection → Meeting AI → AI Writing → content-ai-creation → highest count
// "ai-detection" and "meeting-ai" are not in the current taxonomy; "content-ai-creation" is the
// largest category (25 tools) and covers the site's strongest editorial cluster.
const prioritySlugs = ['ai-detection', 'meeting-ai', 'ai-writing', 'content-ai-creation'];
const defaultCatId: string = (() => {
  for (const slug of prioritySlugs) {
    if (categoryBrowser.find((c: any) => c.id === slug)) return slug;
  }
  return [...categoryBrowser].sort((a: any, b: any) => b.totalCount - a.totalCount)[0]?.id
    ?? categoryBrowser[0]?.id;
})();

// ── JSON-LD ──────────────────────────────────────────────
const SITE = "https://zotopie.com";
const homeJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: `${SITE}/`,
      name: "Zotopie",
      description: `Expert software tool reviews across ${catCount} categories.`,
      potentialAction: {
        "@type": "SearchAction",
        target: { "@type": "EntryPoint", urlTemplate: `${SITE}/search/?q={search_term_string}` },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "Zotopie",
      url: `${SITE}/`,
      logo: { "@type": "ImageObject", url: `${SITE}/images/og-homepage.webp`, width: 1200, height: 630 },
      sameAs: [],
    },
  ],
});
---

<MainLayout
  title="Zotopie — Find the Best Software Tools"
  description="Search 100+ expert software tool reviews. Find the right tool for your workflow — honest reviews, no fluff."
  image="/images/og-homepage.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={homeJsonLd} />
  </Fragment>

  <!-- ── HERO ─────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <circle cx="6" cy="6" r="5" fill="#7C3AED" opacity="0.2"/>
          <circle cx="6" cy="6" r="2.5" fill="#7C3AED"/>
        </svg>
        Expert Software Directory
      </div>
      <h1>Find The <span class="hero-accent">Best Tools</span><br />For Your Success</h1>
      <p class="hero-sub">Search {toolCount}+ expert reviews across {catCount} categories — no fluff, just honest ratings.</p>

      <div class="hero-search-wrap">
        <form class="hero-search-form" action="/search" method="get" role="search">
          <div class="hs-particles" aria-hidden="true">
            <span class="hs-dot" style="left:10%;top:30%;--dur:2.1s;--delay:0s;--tx:18px;--ty:-14px;"></span>
            <span class="hs-dot" style="left:25%;top:70%;--dur:2.5s;--delay:0.3s;--tx:-12px;--ty:-20px;"></span>
            <span class="hs-dot" style="left:50%;top:20%;--dur:1.9s;--delay:0.6s;--tx:8px;--ty:16px;"></span>
            <span class="hs-dot" style="left:70%;top:60%;--dur:2.3s;--delay:0.1s;--tx:-18px;--ty:-10px;"></span>
            <span class="hs-dot" style="left:85%;top:40%;--dur:2.8s;--delay:0.5s;--tx:14px;--ty:-18px;"></span>
            <span class="hs-dot" style="left:40%;top:80%;--dur:2.0s;--delay:0.8s;--tx:-10px;--ty:12px;"></span>
          </div>
          <svg class="hero-s-icon" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="#9ca3af" stroke-width="2.5" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input id="hero-q" name="q" type="text"
            placeholder={`Search ${toolCount}+ software tools…`}
            autocomplete="off" spellcheck="false"
            aria-label="Search software tools" />
          <button type="submit" class="hero-search-btn">Search</button>
        </form>
        <div id="hero-drop" class="ac-drop" role="listbox" aria-label="Search suggestions" hidden></div>
      </div>

      <div class="hero-trust">
        <div class="trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          No sponsored placements
        </div>
        <div class="trust-dot" aria-hidden="true"></div>
        <div class="trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Editorial independence
        </div>
        <div class="trust-dot" aria-hidden="true"></div>
        <div class="trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Real user-tested reviews
        </div>
      </div>

      <div class="hero-cats" role="list" aria-label="Browse by category">
        {top8cats.map((cat) => (
          <a href={`/category/${cat.slug}/`} class="hero-cat-chip" role="listitem">{cat.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── STATS BAR ─────────────────────────────────────── -->
  <div class="stats-bar">
    <div class="stat-item">
      <div class="stat-icon stat-icon-purple">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      </div>
      <div>
        <span class="stat-num">{toolCount}+</span>
        <span class="stat-lbl">Expert Reviews</span>
      </div>
    </div>
    <div class="stat-divider" aria-hidden="true"></div>
    <div class="stat-item">
      <div class="stat-icon stat-icon-blue">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      </div>
      <div>
        <span class="stat-num">{catCount}</span>
        <span class="stat-lbl">Categories</span>
      </div>
    </div>
    <div class="stat-divider" aria-hidden="true"></div>
    <div class="stat-item">
      <div class="stat-icon stat-icon-pink">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
      </div>
      <div>
        <span class="stat-num">{compareCount}+</span>
        <span class="stat-lbl">Comparisons</span>
      </div>
    </div>
    <div class="stat-divider" aria-hidden="true"></div>
    <div class="stat-item">
      <div class="stat-icon stat-icon-green">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <div>
        <span class="stat-num">100%</span>
        <span class="stat-lbl">Independent</span>
      </div>
    </div>
  </div>

  <!-- ── BROWSE SOFTWARE BY CATEGORY ───────────────────── -->
  <section class="section cb-section">
    <div class="section-header">
      <div>
        <h2>Browse Software by Category</h2>
        <p class="section-sub">Independently researched reviews, comparisons, and buying guides — no sponsored rankings.</p>
      </div>
      <a href="/category/" class="see-all">Browse All {categoryBrowser.length} Categories →</a>
    </div>

    <div class="cb-body" id="cb-body">
      <!-- Left nav -->
      <div class="cb-nav" role="tablist" aria-label="Software categories" id="cb-nav">
        {categoryBrowser.map((cat) => (
          <button
            class:list={['cb-nav-btn', { 'cb-nav-active': cat.id === defaultCatId }]}
            data-cat={cat.id}
            role="tab"
            aria-selected={cat.id === defaultCatId ? 'true' : 'false'}
            aria-controls={`cbp-${cat.id}`}
            id={`cbt-${cat.id}`}
          >
            <div class="cb-nav-text">
              <span class="cb-nav-name">{cat.name}</span>
              <span class="cb-nav-sub">{cat.subtitle}</span>
            </div>
          </button>
        ))}
      </div>

      <!-- Right panels -->
      <div class="cb-panel-wrap">
        {categoryBrowser.map((cat) => (
          <div
            class:list={['cb-panel', { 'cb-panel-active': cat.id === defaultCatId }]}
            id={`cbp-${cat.id}`}
            role="tabpanel"
            aria-labelledby={`cbt-${cat.id}`}
          >
            <!-- Category summary (task: panel header) -->
            <div class="cb-panel-header">
              <div class="cb-panel-headline">
                <span class="cb-ph-name">{cat.name}</span>
                <span class="cb-ph-count">{cat.totalCount} Tools</span>
              </div>
              <p class="cb-ph-desc">{cat.description}</p>
            </div>

            <!-- Featured tools grid -->
            <div class="cb-cards-grid">
              {cat.tools.map((tool) => (
                <div class:list={['cb-card', { 'cb-card-profile': !tool.exists }]}>
                  <div class="cb-card-top">
                    <div class="cb-card-logo-wrap">
                      <ToolLogo tool={tool.toolObj} size={36} />
                    </div>
                    <div class="cb-card-meta">
                      <span class="cb-card-name">{tool.name}</span>
                      {tool.stars !== null && (
                        <span class="cb-card-stars" aria-label={`${tool.rating} out of 5 stars`}>{tool.stars}</span>
                      )}
                    </div>
                  </div>
                  {tool.label
                    ? <span class="cb-card-label">{tool.label}</span>
                    : !tool.exists
                      ? <span class="cb-card-label cb-card-label-profile">Profile Available</span>
                      : null
                  }
                  {tool.desc && <p class="cb-card-desc">{tool.desc}</p>}
                  <div class="cb-card-footer">
                    {tool.exists ? (
                      <>
                        <a href={`/reviews/${tool.slug}/`} class="cb-btn-primary">Read Review</a>
                        <a href={`/alternatives/${tool.slug}/`} class="cb-btn-secondary">Compare →</a>
                      </>
                    ) : (
                      <a href={`/alternatives/${tool.slug}/`} class="cb-btn-profile">View Profile →</a>
                    )}
                  </div>
                </div>
              ))}
            </div>

            <!-- View all link -->
            <div class="cb-panel-footer">
              <a href={`/category/${cat.id}/`} class="cb-panel-viewall">
                Explore all {cat.totalCount} {cat.name} tools →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── LATEST REVIEWS ─────────────────────────────────── -->
  {latestReviews.length > 0 && (
    <section class="section">
      <div class="section-header">
        <div>
          <h2>Latest Reviews</h2>
          <p class="section-sub">In-depth editorial reviews from our research team</p>
        </div>
        <a href="/ai-tools/" class="see-all">All reviews →</a>
      </div>
      <div class="articles-grid">
        {latestReviews.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            slug={post.id}
            category="ai-tools"
            tags={post.data.tags}
            featuredImage={post.data.featuredImage}
            featured={false}
          />
        ))}
      </div>
    </section>
  )}

  <!-- ── LATEST COMPARISONS ────────────────────────────── -->
  {latestComparisons.length > 0 && (
    <section class="section">
      <div class="section-header">
        <div>
          <h2>Latest Comparisons</h2>
          <p class="section-sub">Side-by-side breakdowns to help you choose the right tool</p>
        </div>
        <a href="/comparisons/" class="see-all">All comparisons →</a>
      </div>
      <div class="articles-grid">
        {latestComparisons.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            slug={post.id}
            category="comparisons"
            tags={post.data.tags}
            featuredImage={post.data.featuredImage}
            featured={false}
          />
        ))}
      </div>
    </section>
  )}

  <!-- ── BEST GUIDES ────────────────────────────────────── -->
  <section class="section">
    <div class="section-header">
      <div>
        <h2>Expert Best-Of Guides</h2>
        <p class="section-sub">Independently ranked — no sponsored placements</p>
      </div>
      <a href="/best/" class="see-all">All guides →</a>
    </div>
    <div class="best-grid">
      {bestPages.slice(0, 6).map((page) => (
        <a href={`/best/${page.slug}/`} class="best-card">
          <div class="bc-cat">{page.categoryName}</div>
          <div class="bc-title">{page.h1}</div>
          <div class="bc-count">{page.toolSlugs.length} tools compared →</div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── LATEST ARTICLES ───────────────────────────────── -->
  {latestArticles.length > 0 && (
    <section class="section">
      <div class="section-header">
        <div>
          <h2>Latest Articles</h2>
          <p class="section-sub">Guides, deep-dives, and editorial picks from our team</p>
        </div>
        <a href="/ai-tools/" class="see-all">View all →</a>
      </div>
      <div class="articles-grid">
        {latestArticles.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            slug={post.id}
            category="reddit"
            tags={post.data.tags}
            featuredImage={post.data.featuredImage}
            featured={false}
          />
        ))}
      </div>
    </section>
  )}

  <!-- ── CTA BANNER ────────────────────────────────────── -->
  <section class="cta-section">
    <div class="cta-inner">
      <div class="cta-badge">Expert Directory</div>
      <h2>Find the right tool for your workflow</h2>
      <p>Honest reviews. No fluff. Updated regularly.</p>
      <div class="cta-actions">
        <a href="/reviews/" class="btn-primary">Browse {toolCount} Reviews</a>
        <a href="/search/" class="btn-secondary">Search by feature</a>
      </div>
    </div>
  </section>

</MainLayout>

<!-- ── HERO AUTOCOMPLETE JS ──────────────────────────────── -->
<script define:vars={{ slimTools, slimCats }}>
(function () {
  var TOOLS = slimTools;
  var CATS = slimCats;

  var input = document.getElementById('hero-q');
  var drop = document.getElementById('hero-drop');
  var form = document.querySelector('.hero-search-form');
  var wrap = document.querySelector('.hero-search-wrap');
  var btn  = document.querySelector('.hero-search-btn');
  var icon = document.querySelector('.hero-s-icon');
  if (!input || !drop || !form) return;

  input.addEventListener('focus', function() {
    wrap && wrap.classList.add('hs-focused');
    form.classList.add('hs-form-focused');
    if (icon) icon.setAttribute('stroke', '#7C3AED');
  });
  input.addEventListener('blur', function() {
    setTimeout(function() {
      wrap && wrap.classList.remove('hs-focused');
      form.classList.remove('hs-form-focused');
      if (icon) icon.setAttribute('stroke', '#9ca3af');
    }, 180);
  });

  function syncBtn() {
    if (!btn) return;
    if (input.value.trim()) btn.classList.add('hs-btn-visible');
    else btn.classList.remove('hs-btn-visible');
  }
  input.addEventListener('input', syncBtn);

  var acIdx = -1;
  var acItems = [];
  var acTimer;

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function markMatch(text, q) {
    var s = esc(text);
    if (!q) return s;
    var re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + ')','gi');
    return s.replace(re,'<mark>$1</mark>');
  }
  function suggestTools(q) {
    var ql = q.toLowerCase();
    return TOOLS.filter(function(t){return t[0].toLowerCase().includes(ql);})
      .sort(function(a,b){var ap=a[0].toLowerCase().startsWith(ql)?1:0;var bp=b[0].toLowerCase().startsWith(ql)?1:0;return bp-ap||b[2]-a[2];})
      .slice(0,5);
  }
  function suggestCats(q) {
    var ql = q.toLowerCase();
    return CATS.filter(function(c){return c[0].toLowerCase().includes(ql);}).slice(0,3);
  }
  function renderDrop(q) {
    var ts = suggestTools(q); var cs = suggestCats(q);
    if (!ts.length && !cs.length) { drop.hidden = true; return; }
    var ICON_TOOL='<svg class="ac-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none"/></svg>';
    var ICON_CAT='<svg class="ac-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>';
    var html='';
    if (ts.length) {
      html+='<div class="ac-section"><div class="ac-label">Tools</div>';
      ts.forEach(function(t){html+='<div class="ac-item" data-href="/reviews/'+esc(t[1])+'" role="option" tabindex="-1">'+ICON_TOOL+'<span class="ac-name">'+markMatch(t[0],q)+'</span><span class="ac-rating">★ '+t[2]+'</span></div>';});
      html+='</div>';
    }
    if (cs.length) {
      html+='<div class="ac-section"><div class="ac-label">Categories</div>';
      cs.forEach(function(c){html+='<div class="ac-item" data-href="/category/'+esc(c[1])+'" role="option" tabindex="-1">'+ICON_CAT+'<span class="ac-name">'+markMatch(c[0],q)+'</span></div>';});
      html+='</div>';
    }
    drop.innerHTML=html; drop.hidden=false; acIdx=-1;
    acItems=Array.from(drop.querySelectorAll('.ac-item'));
    acItems.forEach(function(item){
      item.addEventListener('mouseenter',function(){acIdx=acItems.indexOf(item);updateSel();});
      item.addEventListener('click',function(){location.href=item.dataset.href;});
    });
  }
  function closeDrop(){drop.hidden=true;acIdx=-1;acItems=[];}
  function updateSel(){acItems.forEach(function(item,i){item.classList.toggle('ac-item-active',i===acIdx);});}
  input.addEventListener('input',function(){clearTimeout(acTimer);acTimer=setTimeout(function(){var q=input.value.trim();if(q.length<1){closeDrop();return;}renderDrop(q);},100);});
  input.addEventListener('keydown',function(e){
    if(e.key==='Escape'){closeDrop();return;}
    if(!acItems.length)return;
    if(e.key==='ArrowDown'){e.preventDefault();acIdx=Math.min(acIdx+1,acItems.length-1);updateSel();}
    else if(e.key==='ArrowUp'){e.preventDefault();acIdx=Math.max(acIdx-1,-1);updateSel();}
  });
  input.addEventListener('focus',function(){var q=input.value.trim();if(q.length>=1)renderDrop(q);});
  form.addEventListener('submit',function(e){e.preventDefault();if(acIdx>=0&&acItems[acIdx]){location.href=acItems[acIdx].dataset.href;}else if(input.value.trim()){location.href='/search?q='+encodeURIComponent(input.value.trim());}});
  document.addEventListener('click',function(e){if(!e.target.closest('.hero-search-wrap'))closeDrop();});
})();
</script>

