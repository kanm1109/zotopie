---
import MainLayout from "../../layouts/MainLayout.astro";
import { LINK_IN_BIO_FEES, STRIPE_ESTIMATE, VERIFIED_ON } from "../../data/link-in-bio-fees-th.mjs";

const pageTitle = "เครื่องคิดค่าธรรมเนียม Link Bio: Linktree, Beacons และ Stan Store หักไปเท่าไหร่?";
const pageDesc =
  "กรอกยอดขายรายเดือนและมูลค่าเฉลี่ยต่อคำสั่งซื้อเพื่อดูว่า Linktree, Beacons และ Stan Store หักไปเท่าไหร่: ค่าบริการแพ็กเกจ ค่าธรรมเนียมแพลตฟอร์ม และค่าธรรมเนียมดำเนินการชำระเงิน";
const feesJson = JSON.stringify({ tools: LINK_IN_BIO_FEES, stripe: STRIPE_ESTIMATE });
---

<MainLayout title={pageTitle} description={pageDesc} lang="th">
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href="https://zotopie.com/tools/link-in-bio-fee-calculator/" />
    <link rel="alternate" hreflang="es" href="https://zotopie.com/es/calculadora-comisiones-link-en-bio/" />
    <link rel="alternate" hreflang="pt-BR" href="https://zotopie.com/pt-br/calculadora-taxas-link-na-bio/" />
    <link rel="alternate" hreflang="id" href="https://zotopie.com/id/kalkulator-biaya-link-di-bio/" />
    <link rel="alternate" hreflang="fr" href="https://zotopie.com/fr/calculateur-frais-link-in-bio/" />
    <link rel="alternate" hreflang="de" href="https://zotopie.com/de/link-in-bio-gebuehrenrechner/" />
    <link rel="alternate" hreflang="vi" href="https://zotopie.com/vi/may-tinh-phi-link-bio/" />
    <link rel="alternate" hreflang="th" href="https://zotopie.com/th/khreuxng-khid-kha-thrrm-niym-link-bio/" />
    <link rel="alternate" hreflang="tr" href="https://zotopie.com/tr/link-in-bio-ucret-hesaplayici/" />
    <link rel="alternate" hreflang="ar" href="https://zotopie.com/ar/hasibat-rusum-link-in-bio/" />
    <link rel="alternate" hreflang="it" href="https://zotopie.com/it/calcolatore-commissioni-link-in-bio/" />
    <link rel="alternate" hreflang="ja" href="https://zotopie.com/ja/rinku-in-baio-tesuryo-keisanki/" />
    <link rel="alternate" hreflang="x-default" href="https://zotopie.com/tools/link-in-bio-fee-calculator/" />
    <meta property="og:locale" content="th_TH" />
  </Fragment>
  <div class="breadcrumb">
    <a href="/">หน้าแรก</a> &rsaquo; <a href="/th/khrueang-mue-link-bio-thi-di-thisut/">เครื่องมือ Link Bio</a> &rsaquo; <span>เครื่องคิดค่าธรรมเนียม</span>
  </div>

  <h1>เครื่องคิดค่าธรรมเนียม Link Bio</h1>
  <p class="intro">
    คุณขายสินค้าผ่านลิงก์ในไบโอใช่ไหม? กรอกตัวเลขของคุณแล้วดูว่าแต่ละเครื่องมือ
    หักไปเท่าไหร่จากยอดขายของคุณ — ค่าบริการแพ็กเกจรายเดือน ค่าธรรมเนียมแพลตฟอร์ม และค่าธรรมเนียมดำเนินการชำระเงิน
    — เพื่อเลือกเครื่องมือที่ถูกที่สุดตามยอดขายของคุณ
  </p>

  <p class="verify-note">
    <strong>ตรวจสอบราคาแล้ว {VERIFIED_ON}:</strong> ราคาแพ็กเกจและค่าธรรมเนียมนำมาจากเว็บไซต์อย่างเป็นทางการของผู้ให้บริการ
    (ดอลลาร์สหรัฐ คิดรายเดือน) ราคาแตกต่างกันไปตามภูมิภาคและเปลี่ยนแปลงบ่อย โปรดตรวจสอบเว็บไซต์ของผู้ให้บริการก่อนซื้อ
    แพ็กเกจฟรีของ Linktree ขายสินค้าแบบเสียเงินไม่ได้ จึงไม่ปรากฏในตารางเปรียบเทียบ
  </p>

  <section class="calc-box">
    <div class="inputs">
      <label>
        ยอดขายรายเดือน ($)
        <input id="sales" type="number" min="0" step="10" value="500" />
      </label>
      <label>
        มูลค่าเฉลี่ยต่อคำสั่งซื้อ ($)
        <input id="avg-order" type="number" min="1" step="1" value="25" />
      </label>
    </div>

    <div id="results" class="results"></div>
    <p id="winner" class="winner"></p>
  </section>

  <section class="how">
    <h2>วิธีการคำนวณ</h2>
    <p>
      สำหรับแต่ละเครื่องมือ เราเลือกแพ็กเกจที่มีต้นทุนรวมรายเดือนต่ำที่สุดสำหรับยอดขายของคุณ แล้วหักออกดังนี้:
    </p>
    <ol>
      <li><strong>ค่าบริการแพ็กเกจรายเดือน</strong> — ราคาของแพ็กเกจ</li>
      <li><strong>ค่าธรรมเนียมแพลตฟอร์ม</strong> — เปอร์เซ็นต์ที่เครื่องมือหักจากแต่ละคำสั่งซื้อ (0% สำหรับแพ็กเกจระดับสูงกว่า)</li>
      <li>
        <strong>ค่าธรรมเนียมดำเนินการชำระเงิน (โดยประมาณ)</strong> — {(STRIPE_ESTIMATE.pct * 100).toFixed(1).replace(".", ",")}% + $
        {STRIPE_ESTIMATE.perOrder.toFixed(2).replace(".", ",")} ต่อคำสั่งซื้อ โดยประมาณตาม Stripe ผู้ให้บริการชำระเงินของคุณ (Stripe, PayPal) อาจคิดค่าธรรมเนียมต่างกัน
      </li>
    </ol>
    <p>
      ตัวอย่าง: ยอดขาย $500 ด้วยมูลค่าเฉลี่ยต่อคำสั่งซื้อ $25 เท่ากับ 20 คำสั่งซื้อ ด้วย Linktree Pro
      ($17/เดือน ค่าธรรมเนียม 0%) คุณจะได้รับ $500 − $17 − $0 − (2,9% × $500 + 20 × $0,30) =
      <strong>$462,50</strong>.
    </p>
  </section>

  <section class="faq">
    <h2>คำถามที่พบบ่อย</h2>
    <h3>เครื่องมือ Link Bio ใดถูกที่สุดสำหรับผู้ขายรายย่อย?</h3>
    <p>
      เมื่อยอดขายยังน้อย แพ็กเกจฟรีที่หักค่าธรรมเนียม 9% อาจทำให้คุณเสียเงินมากกว่าแพ็กเกจแบบเสียเงินที่หัก 0%
      ลองใช้เครื่องคิดเลขนี้ดู ตัวเลือกที่ถูกที่สุดจะเปลี่ยนไปเมื่อยอดขายรายเดือนของคุณเกินหลายร้อยดอลลาร์
    </p>
    <h3>เครื่องคิดเลขนี้รวมค่าธรรมเนียมดำเนินการชำระเงินหรือไม่?</h3>
    <p>
      ใช่ คิดตามค่าประมาณ (2,9% + $0,30 ต่อคำสั่งซื้อ) นี่ไม่ใช่ค่าธรรมเนียมของผู้ให้บริการ แต่เป็นจำนวน
      ที่ผู้ให้บริการชำระเงินมักเรียกเก็บเพิ่ม
    </p>
    <h3>ฉันสามารถเปรียบเทียบเครื่องมือเหล่านี้อย่างละเอียดได้ที่ไหน?</h3>
    <p>
      อ่านคู่มือของเราเกี่ยวกับ<a href="/th/khrueang-mue-link-bio-thi-di-thisut/">เครื่องมือ Link Bio ที่ดีที่สุด</a>
      เพื่อเปรียบเทียบอย่างละเอียดตามแต่ละกรณีการใช้งาน
    </p>
  </section>

  <script define:vars={{ feesJson }}>
    const data = JSON.parse(feesJson);
    const salesEl = document.getElementById("sales");
    const avgEl = document.getElementById("avg-order");
    const resultsEl = document.getElementById("results");
    const winnerEl = document.getElementById("winner");

    function money(n) {
      return "$" + n.toLocaleString("th-TH", { minimumFractionDigits: 2, maximumFractionDigits: 2 }).replace(".", ",");
    }

    function calc() {
      const sales = Math.max(0, parseFloat(salesEl.value) || 0);
      const avg = Math.max(1, parseFloat(avgEl.value) || 1);
      const orders = sales / avg;
      const stripeFee = sales * data.stripe.pct + orders * data.stripe.perOrder;

      const rows = data.tools.map((tool) => {
        let best = null;
        for (const plan of tool.plans) {
          const total = plan.monthly + sales * plan.feePct + stripeFee;
          if (!best || total < best.total) {
            best = { plan, total, platformFee: sales * plan.feePct };
          }
        }
        return {
          tool: tool.name,
          slug: tool.slug,
          plan: best.plan.name,
          planFee: best.plan.monthly,
          platformFee: best.platformFee,
          stripeFee,
          keep: sales - best.total,
        };
      });

      rows.sort((a, b) => b.keep - a.keep);

      resultsEl.innerHTML =
        "<table><thead><tr><th>เครื่องมือ</th><th>แพ็กเกจที่ดีที่สุด</th><th>ค่าบริการแพ็กเกจ</th><th>ค่าธรรมเนียมแพลตฟอร์ม</th><th>การดำเนินการ (โดยประมาณ)</th><th>คุณได้รับ</th></tr></thead><tbody>" +
        rows
          .map(
            (r, i) =>
              `<tr${i === 0 ? ' class="best-row"' : ""}><td><span class="calc-tool"><img src="/logos/${r.slug}.svg" width="24" height="24" alt="${r.tool} logo" loading="lazy" /><strong>${r.tool}</strong></span></td><td>${r.plan}</td><td>${money(r.planFee)}</td><td>${money(r.platformFee)}</td><td>${money(r.stripeFee)}</td><td><strong>${money(r.keep)}</strong></td></tr>`
          )
          .join("") +
        "</tbody></table>";

      winnerEl.textContent =
        sales > 0
          ? `ตัวเลือกที่ถูกที่สุดสำหรับยอดขายของคุณ: ${rows[0].tool} (${rows[0].plan}): คุณได้รับ ${money(rows[0].keep)} จาก ${money(sales)}.`
          : "กรอกยอดขายรายเดือนของคุณเพื่อดูว่าเครื่องมือใดช่วยให้คุณได้รับมากที่สุด";
    }

    salesEl.addEventListener("input", calc);
    avgEl.addEventListener("input", calc);
    calc();
  </script>

  <style>
    .breadcrumb { font-size: 0.875rem; color: #9ca3af; padding: 24px 0 0; margin-bottom: 24px; }
    .breadcrumb a { color: #6b7280; }
    h1 { font-size: 2rem; font-weight: 800; color: #111827; margin: 0 0 12px; line-height: 1.15; }
    .intro { font-size: 1.05rem; color: #4b5563; line-height: 1.7; max-width: 780px; }
    .verify-note { background: #fefce8; border: 1px solid #fde68a; border-radius: 10px; padding: 12px 16px; font-size: 0.9rem; color: #713f12; max-width: 780px; line-height: 1.6; }
    .calc-box { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 14px; padding: 24px; margin: 24px 0 32px; max-width: 860px; }
    .inputs { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
    .inputs label { display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem; font-weight: 700; color: #374151; }
    .inputs input { padding: 10px 12px; border: 1.5px solid #d1d5db; border-radius: 8px; font-size: 1rem; width: 200px; }
    .inputs input:focus { outline: none; border-color: #7c3aed; }
    .results table { width: 100%; border-collapse: collapse; font-size: 0.9rem; background: #fff; border-radius: 10px; overflow: hidden; }
    .results th, .results td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #e5e7eb; }
    .results th { background: #f5f3ff; color: #6d28d9; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .results tr.best-row td { background: #f0fdf4; }
    .calc-tool { display: inline-flex; align-items: center; gap: 8px; }
    .calc-tool img { border-radius: 6px; background: #fff; border: 1px solid #E8ECF0; padding: 2px; box-sizing: content-box; object-fit: contain; flex-shrink: 0; }
    .winner { font-weight: 700; color: #15803d; margin: 16px 0 0; }
    .how, .faq { max-width: 780px; }
    .how h2, .faq h2 { font-size: 1.35rem; font-weight: 700; color: #111827; margin: 0 0 14px; }
    .how p, .how li, .faq p { font-size: 0.95rem; color: #374151; line-height: 1.7; }
    .faq h3 { font-size: 1.05rem; font-weight: 700; color: #111827; margin: 20px 0 6px; }
    @media (max-width: 640px) {
      h1 { font-size: 1.6rem; }
      .calc-box { padding: 16px; }
      .inputs input { width: 100%; }
      .results { overflow-x: auto; }
    }
  </style>
</MainLayout>
