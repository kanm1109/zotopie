---
import { getCollection } from 'astro:content';
import tools from "../data/generated/tools-enriched.json";
import taxonomies from "../data/taxonomies.json";
import iconData from "../data/generated/icon-data.json";
import logoSlugs from "../data/generated/logo-slugs.json";
import MainLayout from "../layouts/MainLayout.astro";

const toolsData      = JSON.stringify(tools.map(({
  name, slug, description, website, pricing, startingPrice,
  rating, primaryCategory, categories, affiliate, simple_icon,
  alternatives, bestFor, overview,
}) => ({
  name, slug, description, website, pricing, startingPrice,
  rating, primaryCategory, categories, affiliate, simple_icon,
  alternatives, bestFor, overview,
})));
const taxonomiesData = JSON.stringify(taxonomies);
const iconDataStr    = JSON.stringify(iconData);
const logoSlugsStr   = JSON.stringify(logoSlugs);

// Collect all articles from every content collection; allSettled tolerates empty collections
const _cols = await Promise.allSettled([
  getCollection('reddit',     ({ data }) => !data.draft),
  getCollection('threads',    ({ data }) => !data.draft),
  getCollection('extensions', ({ data }) => !data.draft),
  getCollection('marketing',  ({ data }) => !data.draft),
  getCollection('ai-tools',   ({ data }) => !data.draft),
]);
const COL_NAMES = ['reddit', 'threads', 'extensions', 'marketing', 'ai-tools'];
const allArticles = _cols.flatMap((res, i) => {
  if (res.status !== 'fulfilled') return [];
  return res.value.map((p) => ({
    title:       p.data.title,
    description: p.data.description || '',
    slug:        p.id,
    collection:  COL_NAMES[i],
    tags:        p.data.tags || [],
    publishDate: p.data.publishDate?.toISOString?.()?.slice(0, 10) || '',
  }));
}).sort((a, b) => b.publishDate.localeCompare(a.publishDate));

const articlesData = JSON.stringify(allArticles);

// JSON-LD: WebSite (with SearchAction) + WebPage
const SITE = "https://zotopie.com";
const searchJsonLdStr = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: `${SITE}/`,
      name: "Zotopie",
      description: "Find reviews, comparisons and alternatives for the best software tools.",
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${SITE}/search?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${SITE}/search/#webpage`,
      url: `${SITE}/search/`,
      name: "Search Tools | Zotopie",
      description: "Search across hundreds of software tool reviews by name, description, or category.",
      isPartOf: { "@id": `${SITE}/#website` },
      breadcrumb: {
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home",   item: `${SITE}/` },
          { "@type": "ListItem", position: 2, name: "Search" },
        ],
      },
    },
  ],
});
---

<MainLayout
  title="Search Tools | Zotopie"
  description="Search across hundreds of software tool reviews by name, description, or category."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
    <script type="application/ld+json" set:html={searchJsonLdStr} />
  </Fragment>

  <section class="search-hero">
    <h1>Search Tools &amp; Articles</h1>
    <p class="search-sub">Find tools by name or category — or discover in-depth reviews and guides.</p>

    <div class="search-box">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="#9ca3af" stroke-width="2.5">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        id="q"
        type="search"
        placeholder="Try &quot;SEO&quot;, &quot;automation&quot;, &quot;scheduling&quot;…"
        autocomplete="off"
        spellcheck="false"
        autofocus
      />
      <div id="ac-drop" class="ac-drop" role="listbox" aria-label="Search suggestions" hidden></div>
    </div>

    <div id="cat-filters" class="cat-filter-row" role="group" aria-label="Filter by category"></div>

    <p id="count" class="result-count" aria-live="polite"></p>
  </section>

  <div id="results"></div>

</MainLayout>

<script define:vars={{ toolsData, taxonomiesData, iconDataStr, articlesData, logoSlugsStr }}>
const TOOLS = JSON.parse(toolsData);
const TAXONOMIES = JSON.parse(taxonomiesData);
const ICON_DATA = JSON.parse(iconDataStr);
const ARTICLES  = JSON.parse(articlesData);
const LOGO_SLUGS = JSON.parse(logoSlugsStr);

const COL_LABEL = { reddit: 'Reddit', threads: 'Threads', extensions: 'Extensions', marketing: 'Marketing', 'ai-tools': 'AI Tools' };

const PALETTE = [
  '#7C3AED','#7c3aed','#059669',
  '#dc2626','#d97706','#0891b2',
  '#be185d','#16a34a',
];

function catName(slug) {
  const t = TAXONOMIES.find((x) => x.slug === slug);
  return t ? t.name : slug;
}

function initials(name) {
  return name.replace(/[^a-zA-Z0-9]/g, '').slice(0, 2).toUpperCase();
}

function logoHtml(tool) {
  const bg   = PALETTE[tool.slug.charCodeAt(0) % PALETTE.length];
  const sz   = 48;
  const fs   = Math.round(sz * 0.38);
  const icon = tool.simple_icon ? ICON_DATA[tool.simple_icon] : null;
  if (icon) {
    return `<svg width="${sz}" height="${sz}" viewBox="0 0 24 24" class="rc-logo-svg" style="fill:#${icon.hex}" aria-label="${esc(tool.name)} logo" role="img"><path d="${icon.path}"/></svg>`;
  }
  if (LOGO_SLUGS.includes(tool.slug)) {
    return `<img src="/logos/${tool.slug}.svg" width="${sz}" height="${sz}" class="rc-logo-img" alt="${esc(tool.name)} logo" loading="lazy" />`;
  }
  return `<span class="rc-logo-fb" style="width:${sz}px;height:${sz}px;background:${bg};font-size:${fs}px" aria-hidden="true">${initials(tool.name)}</span>`;
}

function esc(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function highlight(text, q) {
  if (!q) return esc(text);
  const re = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')})`, 'gi');
  return esc(text).replace(re, '<mark>$1</mark>');
}

function renderCard(tool, q) {
  const cats = tool.categories
    .map((s) => `<a href="/category/${s}" class="rc-cat">${esc(catName(s))}</a>`)
    .join('');
  const price = tool.startingPrice
    ? `${esc(tool.pricing)} · from ${esc(tool.startingPrice)}`
    : esc(tool.pricing);
  return `
<div class="rc-card">
  <div class="rc-top">
    <div class="rc-id">
      ${logoHtml(tool)}
      <h3 class="rc-name"><a href="/reviews/${tool.slug}">${highlight(tool.name, q)}</a></h3>
    </div>
    <span class="rc-rating">★ ${tool.rating}</span>
  </div>
  <p class="rc-desc">${highlight(tool.description, q)}</p>
  ${cats ? `<div class="rc-cats">${cats}</div>` : ''}
  <div class="rc-footer">
    <span class="rc-pricing">${price}</span>
    <a href="/reviews/${tool.slug}" class="rc-cta">Read Review &rarr;</a>
  </div>
</div>`;
}

// ── Article scoring ────────────────────────────────────────────────────────
function scoreArticle(article, q) {
  let score = 0;
  const titleLo = article.title.toLowerCase();
  if (titleLo === q)                                        score += 30;
  else if (titleLo.startsWith(q))                          score += 20;
  else if (titleLo.includes(q))                            score += 10;
  if (article.tags?.some((t) => t.toLowerCase().includes(q))) score += 8;
  if (article.description?.toLowerCase().includes(q))      score += 3;
  if (article.slug.toLowerCase().includes(q))              score += 1;
  return score;
}

function renderArticleCard(article, q) {
  const url   = `/${article.collection}/${article.slug}/`;
  const label = COL_LABEL[article.collection] || article.collection;
  return `
<div class="rc-card rc-article-card">
  <div class="rc-top">
    <div class="rc-id">
      <span class="rc-art-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </span>
      <h3 class="rc-name"><a href="${url}">${highlight(article.title, q)}</a></h3>
    </div>
    <span class="rc-art-badge">${esc(label)}</span>
  </div>
  <p class="rc-desc">${highlight(article.description, q)}</p>
  <div class="rc-footer">
    <span class="rc-pricing">${esc(article.publishDate)}</span>
    <a href="${url}" class="rc-cta rc-cta-article">Read Article &rarr;</a>
  </div>
</div>`;
}

const POPULAR = ['SEO', 'Automation', 'AI Writing', 'Social Media'];
const POPULAR_HTML = `<div class="popular-wrap">
  <p class="popular-label">Popular Searches</p>
  <div class="popular-chips">
    ${POPULAR.map((t) => `<button class="popular-chip" onclick="fillSearch('${t}')">${t}</button>`).join('')}
  </div>
</div>`;

function fillSearch(term) {
  const input = document.getElementById('q');
  input.value = term;
  onInput();
  input.focus();
}

// â”€â”€ Relevance scoring â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function scoreMatch(tool, q) {
  let score = 0;
  const nameLo = tool.name.toLowerCase();
  if (nameLo === q)                                        score += 30; // exact name
  else if (nameLo.startsWith(q))                          score += 20; // name prefix
  else if (nameLo.includes(q))                            score += 10; // name contains
  if (tool.categories.some((s) =>
    s.toLowerCase() === q || catName(s).toLowerCase() === q)) score += 9; // exact category
  else if (tool.categories.some((s) =>
    s.toLowerCase().includes(q) || catName(s).toLowerCase().includes(q))) score += 7; // partial category
  if (tool.bestFor?.some((b) => b.toLowerCase().includes(q)))  score += 5; // bestFor
  if (tool.overview?.toLowerCase().includes(q))                score += 3; // overview
  if (tool.description.toLowerCase().includes(q))              score += 2; // description
  if (tool.slug.toLowerCase().includes(q))                     score += 1; // slug
  return score;
}

// â”€â”€ Category filter state â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
let activeCat = '';

const catCounts = {};
TOOLS.forEach((t) => t.categories.forEach((c) => { catCounts[c] = (catCounts[c] || 0) + 1; }));
const topCats = Object.entries(catCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 14)
  .map(([slug]) => slug);

function renderCatChips() {
  const allActive = !activeCat ? ' cat-chip-active' : '';
  const chips = topCats.map((slug) => {
    const active = slug === activeCat ? ' cat-chip-active' : '';
    return `<button class="cat-chip${active}" data-cat="${slug}">${esc(catName(slug))}</button>`;
  });
  return `<button class="cat-chip${allActive}" data-cat="">All</button>${chips.join('')}`;
}

function initCatChips() {
  const el = document.getElementById('cat-filters');
  el.innerHTML = renderCatChips();
  el.addEventListener('click', (e) => {
    const btn = e.target.closest('.cat-chip');
    if (!btn) return;
    activeCat = btn.dataset.cat || '';
    el.innerHTML = renderCatChips();
    doSearch(document.getElementById('q').value);
  });
}

// â”€â”€ Search â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function doSearch(raw) {
  const q = raw.trim().toLowerCase();
  const countEl = document.getElementById('count');
  const resultsEl = document.getElementById('results');

  if (!q && !activeCat) {
    countEl.textContent = '';
    resultsEl.innerHTML = POPULAR_HTML;
    return;
  }

  // Tool hits (category filter applies only to tools)
  let toolHits;
  if (!q && activeCat) {
    toolHits = TOOLS.filter((t) => t.categories.includes(activeCat));
  } else {
    toolHits = TOOLS
      .map((t) => ({ tool: t, score: scoreMatch(t, q) }))
      .filter((x) => x.score > 0 && (!activeCat || x.tool.categories.includes(activeCat)))
      .sort((a, b) => b.score - a.score)
      .map((x) => x.tool);
  }

  // Article hits (no category filter — articles use their own tag taxonomy)
  const articleHits = q
    ? ARTICLES
        .map((a) => ({ art: a, score: scoreArticle(a, q) }))
        .filter((x) => x.score > 0)
        .sort((a, b) => b.score - a.score)
        .map((x) => x.art)
    : [];

  const label = activeCat
    ? (q ? `"${raw.trim()}" in ${catName(activeCat)}` : catName(activeCat))
    : `"${raw.trim()}"`;

  const total = toolHits.length + articleHits.length;

  if (total === 0) {
    countEl.textContent = `No results for ${label}`;
    resultsEl.innerHTML = `<div class="no-results">Try a different keyword or <a href="/category">browse categories</a>.</div>`;
  } else {
    const parts = [];
    if (toolHits.length)    parts.push(`${toolHits.length} tool${toolHits.length === 1 ? '' : 's'}`);
    if (articleHits.length) parts.push(`${articleHits.length} article${articleHits.length === 1 ? '' : 's'}`);
    countEl.textContent = `${parts.join(', ')} for ${label}`;

    let html = '';
    if (toolHits.length) {
      html += `<section class="result-group">` +
        `<h2 class="rg-title">Tools <span class="rg-count">${toolHits.length}</span></h2>` +
        `<div class="results-grid">${toolHits.map((t) => renderCard(t, q)).join('')}</div>` +
        `</section>`;
    }
    if (articleHits.length) {
      html += `<section class="result-group">` +
        `<h2 class="rg-title">Articles <span class="rg-count">${articleHits.length}</span></h2>` +
        `<div class="results-grid">${articleHits.map((a) => renderArticleCard(a, q)).join('')}</div>` +
        `</section>`;
    }
    resultsEl.innerHTML = html;
  }

  // GA4 search event
  if (q && typeof gtag === 'function') {
    gtag('event', 'search', {
      search_term: q,
      results_count: total,
      category_filter: activeCat || null,
    });
  }
}

const input = document.getElementById('q');

let timer;
function onInput() {
  const val = input.value;

  const url = new URL(location.href);
  val.trim() ? url.searchParams.set('q', val.trim()) : url.searchParams.delete('q');
  history.replaceState(null, '', url);

  clearTimeout(timer);
  timer = setTimeout(() => doSearch(val), 180);
}

input.addEventListener('input', onInput);
initCatChips();

const init = new URLSearchParams(location.search).get('q') || '';
if (init) { input.value = init; doSearch(init); }
else { doSearch(''); }

// â”€â”€ Autocomplete â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
(function() {
  var acDrop = document.getElementById('ac-drop');
  if (!acDrop) return;

  var slimTools = TOOLS.map(function(t) { return [t.name, t.slug, t.rating]; });
  var slimCats = TAXONOMIES.map(function(t) { return [t.name, t.slug]; });

  var acIdx = -1;
  var acItems = [];
  var acTimer;

  function escAc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function markAc(text, q) {
    var s = escAc(text);
    if (!q) return s;
    var re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + ')', 'gi');
    return s.replace(re, '<mark>$1</mark>');
  }

  function suggestAcTools(q) {
    var ql = q.toLowerCase();
    return slimTools
      .filter(function(t) { return t[0].toLowerCase().includes(ql); })
      .sort(function(a, b) {
        var ap = a[0].toLowerCase().startsWith(ql) ? 1 : 0;
        var bp = b[0].toLowerCase().startsWith(ql) ? 1 : 0;
        return bp - ap || b[2] - a[2];
      })
      .slice(0, 5);
  }

  function suggestAcCats(q) {
    var ql = q.toLowerCase();
    return slimCats.filter(function(c) { return c[0].toLowerCase().includes(ql); }).slice(0, 3);
  }

  function suggestAcArticles(q) {
    var ql = q.toLowerCase();
    return ARTICLES
      .filter(function(a) {
        return a.title.toLowerCase().includes(ql) ||
          (a.tags && a.tags.some(function(t) { return t.toLowerCase().includes(ql); }));
      })
      .sort(function(a, b) {
        var ap = a.title.toLowerCase().startsWith(ql) ? 1 : 0;
        var bp = b.title.toLowerCase().startsWith(ql) ? 1 : 0;
        return bp - ap;
      })
      .slice(0, 3);
  }

  function renderAcDrop(q) {
    var tools = suggestAcTools(q);
    var cats = suggestAcCats(q);
    var arts = suggestAcArticles(q);
    if (!tools.length && !cats.length && !arts.length) { acDrop.hidden = true; return; }

    var html = '';
    if (tools.length) {
      html += '<div class="ac-section"><div class="ac-label">Tools</div>';
      tools.forEach(function(t) {
        html += '<div class="ac-item" data-href="/reviews/' + escAc(t[1]) + '" role="option" tabindex="-1">' +
          '<span class="ac-name">' + markAc(t[0], q) + '</span>' +
          '<span class="ac-rating">&#9733; ' + t[2] + '</span>' +
          '</div>';
      });
      html += '</div>';
    }
    if (arts.length) {
      html += '<div class="ac-section"><div class="ac-label">Articles</div>';
      arts.forEach(function(a) {
        var url = '/' + a.collection + '/' + a.slug + '/';
        html += '<div class="ac-item" data-href="' + escAc(url) + '" role="option" tabindex="-1">' +
          '<span class="ac-name">' + markAc(a.title, q) + '</span>' +
          '<span class="ac-art-col">' + escAc(COL_LABEL[a.collection] || a.collection) + '</span>' +
          '</div>';
      });
      html += '</div>';
    }
    if (cats.length) {
      html += '<div class="ac-section"><div class="ac-label">Categories</div>';
      cats.forEach(function(c) {
        html += '<div class="ac-item" data-href="/category/' + escAc(c[1]) + '" role="option" tabindex="-1">' +
          '<span class="ac-name">' + markAc(c[0], q) + '</span>' +
          '</div>';
      });
      html += '</div>';
    }

    acDrop.innerHTML = html;
    acDrop.hidden = false;
    acIdx = -1;
    acItems = Array.from(acDrop.querySelectorAll('.ac-item'));
    acItems.forEach(function(item) {
      item.addEventListener('mouseenter', function() {
        acIdx = acItems.indexOf(item);
        updateAcSel();
      });
      item.addEventListener('click', function() {
        location.href = item.dataset.href;
      });
    });
  }

  function closeAcDrop() {
    acDrop.hidden = true;
    acIdx = -1;
    acItems = [];
  }

  function updateAcSel() {
    acItems.forEach(function(item, i) {
      item.classList.toggle('ac-item-active', i === acIdx);
    });
  }

  input.addEventListener('input', function() {
    clearTimeout(acTimer);
    acTimer = setTimeout(function() {
      var q = input.value.trim();
      if (q.length < 1) { closeAcDrop(); return; }
      renderAcDrop(q);
    }, 80);
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { closeAcDrop(); return; }
    if (!acItems.length) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      acIdx = Math.min(acIdx + 1, acItems.length - 1);
      updateAcSel();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      acIdx = Math.max(acIdx - 1, -1);
      updateAcSel();
    } else if (e.key === 'Enter' && acIdx >= 0 && acItems[acIdx]) {
      e.preventDefault();
      location.href = acItems[acIdx].dataset.href;
    }
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.search-box')) closeAcDrop();
  });
})();
</script>

<style>
  .search-hero {
    padding: 36px 0 24px;
    text-align: center;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 28px;
  }
  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    color: #111827;
    margin: 0 0 10px;
  }
  .search-sub {
    font-size: 1rem;
    color: #6b7280;
    margin: 0 0 28px;
  }

  /* Search box */
  .search-box {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
  }
  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }
  #q {
    width: 100%;
    padding: 14px 20px 14px 48px;
    font-size: 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    outline: none;
    font-family: inherit;
    color: #111827;
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  #q:focus {
    border-color: #7C3AED;
    box-shadow: 0 0 0 3px rgba(124,58,237,0.1);
  }
  #q::placeholder { color: #9ca3af; }

  .result-count {
    margin: 16px 0 0;
