---
import ArticleCard from '../components/ArticleCard.astro';
import BaseHead from '../components/BaseHead.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Pagination from '../components/Pagination.astro';

interface Post {
	id: string;
	data: {
		title: string;
		description: string;
		publishDate: Date;
		tags: string[];
		category: string;
		featuredImage?: string;
		draft: boolean;
	};
	collection: string;
}

interface Props {
	title: string;
	description: string;
	categorySlug: string;
	posts: Post[];
	currentPage: number;
	totalPages: number;
	noindex?: boolean;
}

const { title, description, categorySlug, posts, currentPage, totalPages, noindex = false } =
	Astro.props;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			breadcrumbs={[{ name: title, url: `/${categorySlug}/` }]}
			noindex={noindex}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<SiteHeader />
		<main class="cat-main">
			<div class="cat-header">
				<Breadcrumb items={[{ name: title, url: `/${categorySlug}/` }]} />
				<h1>{title}</h1>
				<p class="cat-desc">{description}</p>
			</div>
			{posts.length > 0 ? (
				<div class="posts-grid">
					{posts.map((post, i) => (
						<ArticleCard
							title={post.data.title}
							description={post.data.description}
							publishDate={post.data.publishDate}
							slug={post.id}
							category={post.collection}
							tags={post.data.tags}
							featuredImage={post.data.featuredImage}
							featured={i === 0 && currentPage === 1}
						/>
					))}
				</div>
			) : (
				<p class="empty">No articles yet. Check back soon!</p>
			)}
			<Pagination
				currentPage={currentPage}
				totalPages={totalPages}
				basePath={`/${categorySlug}`}
			/>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	:root {
		--c-purple: #7C3AED;
		--c-blue: #6366F1;
		--c-dark: #0F172A;
		--c-gray: #647488;
		--c-border: #E8ECF0;
		--c-bg: #FAFBFC;
		--font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
	}
	*, *::before, *::after { box-sizing: border-box; }
	body {
		font-family: var(--font-sans);
		color: var(--c-dark);
		background: #fff;
		-webkit-font-smoothing: antialiased;
	}
	.cat-main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px 80px;
	}
	.cat-header {
		padding: 40px 0 32px;
		border-bottom: 1px solid var(--c-border);
		margin-bottom: 40px;
	}
	h1 {
		font-size: 2.4rem;
		font-weight: 800;
		color: var(--c-dark);
		line-height: 1.15;
		margin: 8px 0 12px;
		text-transform: capitalize;
		letter-spacing: -0.5px;
	}
	.cat-desc {
		font-size: 1.05rem;
		color: var(--c-gray);
		margin: 0;
		max-width: 600px;
		line-height: 1.6;
		overflow-wrap: break-word;
		word-break: break-word;
	}
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 24px;
	}
	.posts-grid > :first-child { grid-column: 1 / -1; }
	.empty {
		text-align: center;
		padding: 4rem;
		color: var(--c-gray);
		font-size: 1rem;
	}
	@media (max-width: 640px) {
		.cat-main { padding: 0 16px 64px; }
		h1 { font-size: 1.8rem; }
		.cat-header { padding: 28px 0 24px; margin-bottom: 28px; }
		.posts-grid { grid-template-columns: 1fr; }
	}
</style>
