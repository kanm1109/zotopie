---
import BaseHead from '../components/BaseHead.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE_URL } from '../consts';
import tools from '../data/generated/tools-enriched.json';

interface Props {
	title: string;
	description: string;
	publishDate: Date;
	updatedDate?: Date;
	author?: string;
	tags?: string[];
	category: string;
	categoryName?: string;
	featuredImage?: string;
}

const {
	title,
	description,
	publishDate,
	updatedDate,
	author = 'Zotopie Team',
	tags = [],
	category,
	categoryName,
	featuredImage,
} = Astro.props;

const displayCategory = categoryName ?? category;
const relatedTool = (tools as any[]).find((t) =>
  tags.includes(t.slug) || tags.some((tag: string) => tag === t.slug)
) ?? null;
const breadcrumbs = [
	{ name: displayCategory, url: `${SITE_URL}/${category}/` },
	{ name: title, url: Astro.url.href },
];
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={featuredImage}
			type="article"
			publishDate={publishDate}
			updatedDate={updatedDate}
			author={author}
			tags={tags}
			breadcrumbs={breadcrumbs}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<SiteHeader />
		<main>
			<article class="article-wrap">
				<div class="article-header">
					<Breadcrumb items={[
						{ name: displayCategory, url: `/${category}/` },
						{ name: title, url: Astro.url.pathname },
					]} />
					{tags.length > 0 && (
						<div class="tags-row">
							{tags.map((tag) => (
								<a href={`/tags/${tag}/`} class="tag">#{tag}</a>
							))}
						</div>
					)}
					<h1>{title}</h1>
					<div class="meta">
						<span>By {author}</span>
						<span class="dot">·</span>
						<FormattedDate date={publishDate} />
						{updatedDate && (
							<>
								<span class="dot">·</span>
								<span>Updated <FormattedDate date={updatedDate} /></span>
							</>
						)}
					</div>
				</div>
				{featuredImage && (
					<div class="hero">
						<img src={featuredImage} alt={title} loading="eager" />
					</div>
				)}
				{relatedTool && (
					<div class="tool-profile-block">
						<div class="tpb-label">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
							Tool Profile
						</div>
						<p class="tpb-name">{relatedTool.name}</p>
						<div class="tpb-meta">
							<span class="tpb-rating">★ {relatedTool.rating}</span>
							<span class="tpb-sep">·</span>
							<span class="tpb-pricing">{relatedTool.pricing}{relatedTool.startingPrice ? ` · from ${relatedTool.startingPrice}` : ''}</span>
						</div>
						<a href={`/reviews/${relatedTool.slug}/`} class="tpb-cta">View Tool Profile →</a>
					</div>
				)}
				<div class="prose">
					<slot />
				</div>
				{tags.length > 0 && (
					<div class="footer-tags">
						<strong>Tags:</strong>
						{tags.map((tag) => (
							<a href={`/tags/${tag}/`} class="tag">#{tag}</a>
						))}
					</div>
				)}
			</article>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	:root {
		--c-purple: #7C3AED;
		--c-blue: #6366F1;
		--c-dark: #0F172A;
		--c-gray: #647488;
		--c-border: #E8ECF0;
		--c-bg: #FAFBFC;
		--font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
	}
	body {
		font-family: var(--font-sans);
		color: var(--c-dark);
		background: #fff;
		-webkit-font-smoothing: antialiased;
	}
	.article-wrap {
		max-width: 780px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}
	.article-header { margin-bottom: 2rem; }
	.tags-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}
	.tag {
		color: var(--c-purple);
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 500;
	}
	.tag:hover { text-decoration: underline; }
	h1 {
		font-size: 2.4rem;
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.5px;
		color: var(--c-dark);
		margin: 0.5rem 0 1rem;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--c-gray);
	}
	.dot { color: var(--c-gray); }
	.hero {
		margin-bottom: 2.5rem;
		border-radius: 12px;
		overflow: hidden;
	}
	.hero img { width: 100%; height: auto; border-radius: 0; }
	.prose {
		font-size: 1.05rem;
		line-height: 1.8;
		overflow-wrap: break-word;
		word-wrap: break-word;
	}
	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 8px;
		display: block;
	}
	.prose :global(table) {
		display: block;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		border-collapse: collapse;
		width: 100%;
		font-size: 0.9rem;
		margin: 1.5rem 0;
	}
	.prose :global(th),
	.prose :global(td) {
		border: 1px solid var(--c-border);
		padding: 0.5rem 0.75rem;
		text-align: left;
		white-space: nowrap;
		vertical-align: top;
	}
	.prose :global(th) {
		background: #F5F3FF;
		font-weight: 600;
		color: var(--c-dark);
	}
	.prose :global(pre) {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		max-width: 100%;
		border-radius: 8px;
		padding: 1rem 1.25rem;
		background: #f1f5f9;
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.prose :global(pre code) {
		background: none;
		padding: 0;
		border-radius: 0;
		font-size: inherit;
	}
	.prose :global(code) {
		font-size: 0.875em;
		background: #f1f5f9;
		padding: 0.125em 0.375em;
		border-radius: 4px;
	}
	.footer-tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--c-border);
		font-size: 0.875rem;
		color: var(--c-gray);
	}
	.footer-tags .tag { color: var(--c-purple); }
	/* TOOL PROFILE BLOCK */
	.tool-profile-block {
		background: #F5F3FF;
		border: 1px solid #DDD6FE;
		border-left: 4px solid var(--c-purple);
		border-radius: 10px;
		padding: 18px 20px;
		margin-bottom: 2rem;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.tpb-label {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--c-purple);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.tpb-label svg { flex-shrink: 0; }
	.tpb-name {
		font-size: 1rem;
		font-weight: 700;
		color: var(--c-dark);
		margin: 0;
	}
	.tpb-meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.85rem;
		color: var(--c-gray);
	}
	.tpb-rating { color: #D97706; font-weight: 600; }
	.tpb-sep { color: var(--c-border); }
	.tpb-cta {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-top: 4px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--c-purple);
		text-decoration: none;
	}
	.tpb-cta:hover { text-decoration: underline; }

	@media (max-width: 720px) {
		h1 { font-size: 1.8rem; }
		.article-wrap { padding: 1rem 1rem 3rem; }
		.tool-profile-block { padding: 14px 16px; }
	}
	@media (max-width: 400px) {
		h1 { font-size: 1.5rem; }
	}
</style>
