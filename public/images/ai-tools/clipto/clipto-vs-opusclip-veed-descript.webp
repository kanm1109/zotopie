<svg width="100%" viewBox="0 0 680 680" role="img" xmlns="http://www.w3.org/2000/svg">
  <title>Clipto vs Opus Clip vs Veed vs Descript – Tool Comparison</title>
  <desc>Side-by-side feature and pricing comparison of four AI video/media tools: Clipto, Opus Clip, Veed, and Descript</desc>

  <!-- Card background -->
  <rect x="20" y="16" width="640" height="648" rx="16" fill="#F8F7F4" stroke="#E0DED6" stroke-width="0.5"/>

  <!-- Header -->
  <rect x="20" y="16" width="640" height="50" rx="16" fill="#2C2C2A" stroke="none"/>
  <rect x="20" y="42" width="640" height="24" fill="#2C2C2A" stroke="none"/>
  <text font-family="sans-serif" font-size="14" font-weight="500" fill="#F1EFE8" x="340" y="46" text-anchor="middle" dominant-baseline="central">Clipto vs Opus Clip vs Veed vs Descript</text>

  <!-- Column header backgrounds -->
  <!-- Feature col -->
  <rect x="20" y="66" width="148" height="46" fill="#E8E6DF" stroke="#D3D1C7" stroke-width="0.5"/>
  <text font-family="sans-serif" font-size="12" font-weight="500" fill="#444441" x="94" y="89" text-anchor="middle" dominant-baseline="central">Feature</text>

  <!-- Clipto -->
  <rect x="168" y="66" width="122" height="46" fill="#E1F5EE" stroke="#9FE1CB" stroke-width="0.5"/>
  <text font-family="sans-serif" font-size="13" font-weight="500" fill="#085041" x="229" y="82" text-anchor="middle" dominant-baseline="central">Clipto</text>
  <text font-family="sans-serif" font-size="10" fill="#0F6E56" x="229" y="101" text-anchor="middle" dominant-baseline="central">Local Search</text>

  <!-- Opus Clip -->
  <rect x="290" y="66" width="122" height="46" fill="#EEEDFE" stroke="#CECBF6" stroke-width="0.5"/>
  <text font-family="sans-serif" font-size="13" font-weight="500" fill="#26215C" x="351" y="82" text-anchor="middle" dominant-baseline="central">Opus Clip</text>
  <text font-family="sans-serif" font-size="10" fill="#534AB7" x="351" y="101" text-anchor="middle" dominant-baseline="central">AI Repurposing</text>

  <!-- Veed -->
  <rect x="412" y="66" width="122" height="46" fill="#FAEEDA" stroke="#FAC775" stroke-width="0.5"/>
  <text font-family="sans-serif" font-size="13" font-weight="500" fill="#412402" x="473" y="82" text-anchor="middle" dominant-baseline="central">Veed</text>
  <text font-family="sans-serif" font-size="10" fill="#854F0B" x="473" y="101" text-anchor="middle" dominant-baseline="central">Online Editor</text>

  <!-- Descript -->
  <rect x="534" y="66" width="126" height="46" fill="#FAECE7" stroke="#F5C4B3" stroke-width="0.5"/>
  <text font-family="sans-serif" font-size="13" font-weight="500" fill="#4A1B0C" x="597" y="82" text-anchor="middle" dominant-baseline="central">Descript</text>
  <text font-family="sans-serif" font-size="10" fill="#993C1D" x="597" y="101" text-anchor="middle" dominant-baseline="central">Text-based Edit</text>

  <!-- ROW 1: Price -->
  <rect x="20" y="112" width="640" height="40" fill="#FFFFFF" stroke="#E0DED6" stroke-width="0.5"/>
  <text font-family="sans-serif" font-size="11" fill="#5F5E5A" x="94" y="132" text-anchor="middle" dominant-baseline="central">Starting price</text>
  <text font-family="sans-serif" font-size="11" font-weight="500" fill="#0F6E56" x="229" y="132" text-anchor="middle" dominant-baseline="central">Free / $8/mo</text>
  <text font-family="sans-serif" font-size="11" font-weight="500" fill="#534AB7" x="351" y="132" text-anchor="middle" dominant-baseline="central">Free / $19/mo</text>
  <text font-family="sans-serif" font-size="11" font-weight="500" fill="#854F0B" x="473" y="132" text-anchor="middle" dominant-baseline="central">Free / $24/mo</text>
  <text font-family="sans-serif" font-size="11" font-weight="500" fill="#993C1D" x="597" y="132" text-anchor="middle" dominant-baseline="central">Free / $24/mo</text>

  <!-- ROW 2: Platform -->
