  <text font-family="sans-serif" font-size="11" fill="#5F5E5A" x="94" y="172" text-anchor="middle" dominant-baseline="central">Platform</text>
  <text font-family="sans-serif" font-size="11" fill="#0F6E56" x="229" y="172" text-anchor="middle" dominant-baseline="central">Mac / iOS only</text>
  <text font-family="sans-serif" font-size="11" fill="#444441" x="351" y="172" text-anchor="middle" dominant-baseline="central">Web</text>
  <text font-family="sans-serif" font-size="11" fill="#444441" x="473" y="172" text-anchor="middle" dominant-baseline="central">Web</text>
  <text font-family="sans-serif" font-size="11" fill="#444441" x="597" y="172" text-anchor="middle" dominant-baseline="central">Web / Mac / Win</text>

