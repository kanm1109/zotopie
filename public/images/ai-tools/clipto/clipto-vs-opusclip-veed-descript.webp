  <text font-family="sans-serif" font-size="11" fill="#5F5E5A" x="94" y="252" text-anchor="middle" dominant-baseline="central">AI Clip Generation</text>
  <text font-family="sans-serif" font-size="12" fill="#A32D2D" x="229" y="252" text-anchor="middle" dominant-baseline="central">✗ Not supported</text>
