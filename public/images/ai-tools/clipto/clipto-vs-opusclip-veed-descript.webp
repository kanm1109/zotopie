  <text font-family="sans-serif" font-size="12" fill="#1D9E75" x="473" y="292" text-anchor="middle" dominant-baseline="central">✓ Partial</text>
  <text font-family="sans-serif" font-size="12" fill="#1D9E75" x="597" y="292" text-anchor="middle" dominant-baseline="central">✓ Manual</text>

  <!-- ROW 6: Media Search -->
  <rect x="20" y="312" width="640" height="40" fill="#F8F7F4" stroke="#E0DED6" stroke-width="0.5"/>
  <text font-family="sans-serif" font-size="11" fill="#5F5E5A" x="94" y="332" text-anchor="middle" dominant-baseline="central">Natural Lang. Search</text>
  <text font-family="sans-serif" font-size="12" font-weight="500" fill="#1D9E75" x="229" y="332" text-anchor="middle" dominant-baseline="central">✓ Core feature</text>
  <text font-family="sans-serif" font-size="12" fill="#A32D2D" x="351" y="332" text-anchor="middle" dominant-baseline="central">✗ No</text>
  <text font-family="sans-serif" font-size="12" fill="#A32D2D" x="473" y="332" text-anchor="middle" dominant-baseline="central">✗ No</text>
  <text font-family="sans-serif" font-size="12" fill="#A32D2D" x="597" y="332" text-anchor="middle" dominant-baseline="central">✗ Limited</text>

  <!-- ROW 7: Privacy / Local -->
  <rect x="20" y="352" width="640" height="40" fill="#FFFFFF" stroke="#E0DED6" stroke-width="0.5"/>
  <text font-family="sans-serif" font-size="11" fill="#5F5E5A" x="94" y="372" text-anchor="middle" dominant-baseline="central">100% Local / Private</text>
  <text font-family="sans-serif" font-size="12" font-weight="500" fill="#1D9E75" x="229" y="372" text-anchor="middle" dominant-baseline="central">✓ Fully local</text>
  <text font-family="sans-serif" font-size="12" fill="#A32D2D" x="351" y="372" text-anchor="middle" dominant-baseline="central">✗ Cloud-based</text>
  <text font-family="sans-serif" font-size="12" fill="#A32D2D" x="473" y="372" text-anchor="middle" dominant-baseline="central">✗ Cloud-based</text>
  <text font-family="sans-serif" font-size="12" fill="#A32D2D" x="597" y="372" text-anchor="middle" dominant-baseline="central">✗ Cloud-based</text>

