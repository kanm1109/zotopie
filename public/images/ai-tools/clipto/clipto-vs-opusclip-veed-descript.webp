  <text font-family="sans-serif" font-size="11" fill="#5F5E5A" x="94" y="452" text-anchor="middle" dominant-baseline="central">Team Collaboration</text>
  <text font-family="sans-serif" font-size="12" fill="#A32D2D" x="229" y="452" text-anchor="middle" dominant-baseline="central">✗ Solo only</text>
  <text font-family="sans-serif" font-size="12" fill="#1D9E75" x="351" y="452" text-anchor="middle" dominant-baseline="central">✓ Team workspace</text>
  <text font-family="sans-serif" font-size="12" fill="#1D9E75" x="473" y="452" text-anchor="middle" dominant-baseline="central">✓ Collaborative</text>
  <text font-family="sans-serif" font-size="12" fill="#1D9E75" x="597" y="452" text-anchor="middle" dominant-baseline="central">✓ Real-time</text>

  <!-- ROW 10: Best For -->
  <rect x="20" y="472" width="640" height="40" fill="#F8F7F4" stroke="#E0DED6" stroke-width="0.5"/>
  <text font-family="sans-serif" font-size="11" fill="#5F5E5A" x="94" y="492" text-anchor="middle" dominant-baseline="central">Best for</text>
  <text font-family="sans-serif" font-size="10" fill="#085041" x="229" y="492" text-anchor="middle" dominant-baseline="central">Media archiving</text>
  <text font-family="sans-serif" font-size="10" fill="#26215C" x="351" y="492" text-anchor="middle" dominant-baseline="central">Short-form creators</text>
  <text font-family="sans-serif" font-size="10" fill="#854F0B" x="473" y="492" text-anchor="middle" dominant-baseline="central">Marketing teams</text>
  <text font-family="sans-serif" font-size="10" fill="#712B13" x="597" y="492" text-anchor="middle" dominant-baseline="central">Podcasters / editors</text>

  <!-- Divider -->
  <line x1="40" y1="524" x2="640" y2="524" stroke="#D3D1C7" stroke-width="0.5"/>

  <!-- Award badges row -->
  <!-- Clipto badge -->
  <rect x="26" y="534" width="148" height="112" rx="10" fill="#E1F5EE" stroke="#5DCAA5" stroke-width="0.5"/>
  <text font-family="sans-serif" font-size="16" x="42" y="558">🏆</text>
  <text font-family="sans-serif" font-size="11" font-weight="500" fill="#085041" x="62" y="556" dominant-baseline="central">Most Private</text>
