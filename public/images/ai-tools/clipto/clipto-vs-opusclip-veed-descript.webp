  <text font-family="sans-serif" font-size="12" fill="#1D9E75" x="229" y="212" text-anchor="middle" dominant-baseline="central">✓ 99% accuracy</text>
  <text font-family="sans-serif" font-size="12" fill="#1D9E75" x="351" y="212" text-anchor="middle" dominant-baseline="central">✓ 97% accuracy</text>
  <text font-family="sans-serif" font-size="12" fill="#1D9E75" x="473" y="212" text-anchor="middle" dominant-baseline="central">✓ Good</text>
  <text font-family="sans-serif" font-size="12" fill="#1D9E75" x="597" y="212" text-anchor="middle" dominant-baseline="central">✓ Excellent</text>

